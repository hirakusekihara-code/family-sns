# ログイン用（ブラウザ標準のBasic認証。Cookieは使いません）
# 本番では必ず両方設定してください。未設定だと本番ではアクセスを拒否します。
APP_USER=me
APP_PASSWORD=change-this-to-a-long-password

# 1 にすると TikTok に接続せず、サンプルデータで画面を確認できます（開発用）
# TT_MOCK=1

# tikwm 公式API（RapidAPI）のキー。Vercel などクラウドで投稿一覧を取得するのに必要
# https://rapidapi.com/tikwm-tikwm-default/api/tiktok-scraper7 で無料プランに登録して取得
# RAPIDAPI_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
